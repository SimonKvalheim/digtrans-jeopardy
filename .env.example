# Copy to .env for local development. Never commit the real thing.
# On Railway these are service variables, set in the dashboard.

# Injected by Railway in production; only needed locally.
PORT=3000

# Use Railway's PRIVATE DATABASE_URL for the app. DATABASE_PUBLIC_URL is for
# running migrations from a laptop and nothing else.
DATABASE_URL=

# Gate /host and /admin. Any non-empty string; they are typed once per device.
HOST_PIN=
ADMIN_PIN=

# Optional — the game runs without both of these (PRD §7, §8).
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=

# Only used by scripts/generate-sfx.mjs when uploading generated stings from a
# laptop. The deployed app never reads these — it serves bytes out of Postgres.
APP_URL=https://your-app.up.railway.app
